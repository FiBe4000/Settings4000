# Rust build artifacts
/target
**/*.rs.bk

# Claude Code per-user settings (shared config under .claude/ stays tracked)
.claude/settings.local.json

# makepkg output beside each PKGBUILD in packaging/arch/ (tasks 12.2 and 12.5):
# its build and package directories, the clone of the git source (named
# settings4000/ for the -git package and settings4000-<version>/ for the
# release package), built packages and logs
/packaging/arch/*/src/
/packaging/arch/*/pkg/
/packaging/arch/*/settings4000/
/packaging/arch/*/settings4000-[0-9]*/
/packaging/arch/**/*.pkg.tar.*
/packaging/arch/**/*.log
