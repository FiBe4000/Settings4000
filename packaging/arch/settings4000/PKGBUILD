# Maintainer: FiBe4000 <https://github.com/FiBe4000>
#
# Arch Linux package for Settings4000, a native GTK 4 settings GUI for a
# dotfiles-managed Hyprland desktop (requirement R8.7 in docs/requirements.md).
# This is the release package: it builds the tagged release named by `pkgver=`
# below, whereas the VCS package in packaging/arch/settings4000-git/ builds the
# latest commit of the default branch. Both install the same four files under
# /usr — the binary, the desktop entry, the icon and the license — and conflict
# with each other, so install one or the other. Build and install from this
# directory:
#
#   makepkg -si
#
# The source is the release's annotated git tag `v$pkgver`, cloned from GitHub,
# not a source tarball. A tarball checksum cannot be committed with the release
# it describes: the tarball of a tag contains this very PKGBUILD, so its hash
# would have to cover itself. A git source pinned with `#tag=` needs no
# checksum (makepkg accepts 'SKIP' for VCS sources), so the release commit can
# carry its own final PKGBUILD and the tag can point at that commit. makepkg 7
# can checksum a `#tag=` source as well (`makepkg -g` hashes `git archive` of
# the tag), but that hash covers the tagged tree including this file, the same
# self-reference, so 'SKIP' is deliberate and must not be "fixed" with
# `makepkg -g`. makepkg still refuses an annotated tag whose embedded name
# differs from the requested one (a "forged" tag; a lightweight tag passes
# silently, so release tags are annotated), and a published release tag is
# never moved. If tags are ever GPG-signed, `?signed` on the source plus
# `validpgpkeys` is the integrity upgrade. Because the tag must already exist
# on GitHub, this package cannot build a version that has not been tagged and
# pushed yet; the -git package covers unreleased work.
#
# `pkgver=` is a literal here, unlike in the -git package, because the version
# selects the tag to build. It must equal the `version` in Cargo.toml (R8.6,
# the single version source); a guard test in src/ui/app.rs fails when the two
# disagree, and also when the build functions, `depends` or `optdepends` drift
# from the -git package's, which are kept textually identical. The steps of a
# release, including this file's `pkgver=`/`pkgrel=` and its .SRCINFO, are in
# docs/releasing.md.
#
# There is no install scriptlet: pacman's own hooks refresh the desktop-entry
# database and the hicolor icon cache for every package that installs under
# /usr/share/applications and /usr/share/icons/hicolor.
#
# This file lives in packaging/arch/settings4000/ rather than at the repository
# root because makepkg creates src/ and pkg/ directories beside the PKGBUILD,
# and src/ at the root is the Rust source tree. Those build directories, the
# clone in ./settings4000-<version>/ and the built package are ignored by the
# repository's .gitignore. Regenerate .SRCINFO with
# `makepkg --printsrcinfo > .SRCINFO` whenever this file changes.

pkgname=settings4000
# Must equal APP_ID in src/ui/app.rs: the desktop entry and the icon are named
# after the GApplication ID so launchers can match the app's windows to them.
# A unit test there pins this exact line.
_app_id=org.settings4000.Settings4000
pkgver=1.1.0
pkgrel=1
pkgdesc='Native GTK 4 settings GUI for a dotfiles-managed Hyprland desktop'
arch=(x86_64)
url='https://github.com/FiBe4000/Settings4000'
license=(MIT)
# Every library the binary links directly (as namcap reports it), even those
# gtk4 already pulls in, plus hicolor-icon-theme, which owns the icon directory.
depends=(
  cairo
  glib2
  glibc
  gtk4
  hicolor-icon-theme
  libgcc
)
makedepends=(
  cargo
  git
)
# The app detects each of these tools at startup and hides the settings that
# need a missing one instead of failing (R4), so none is a hard dependency.
# Two detected tools are absent on purpose: gsettings ships with glib2 (a
# dependency above) and busctl with systemd (part of the base system). pipewire
# and dconf are currently also pulled in through gtk4; they stay listed because
# the app uses them directly and gtk4 may stop requiring them.
optdepends=(
  'hyprland: hyprctl for live reloads and the Display, Input and cursor settings'
  'hyprpaper: Wallpaper settings'
  'hypridle: Power & Idle page'
  'hyprlock: lock-screen background setting'
  'wireplumber: wpctl for the Sound page'
  'pipewire: pw-dump for the Sound page device list'
  'libpulse: pactl, detected as a Sound backend (no current setting needs it)'
  'eww: reload the status bars after theme, wallpaper and display changes'
  'kitty: recolor terminals on a palette change and run nmtui for networks'
  'networkmanager: nmcli for the Network page'
  'nm-connection-editor: preferred editor behind "Open Network Settings"'
  'dconf: live restyling of running GTK apps after a theme change'
)
# The directory makepkg clones the source into. The build functions below only
# ever refer to it through this variable, which keeps them byte-identical to the
# -git package's in packaging/arch/settings4000-git/ (a guard test in
# src/ui/app.rs compares them).
_srcdir=$pkgname-$pkgver
source=("$_srcdir::git+https://github.com/FiBe4000/Settings4000.git#tag=v$pkgver")
# A git source is verified by the tag, not by a checksum (see the header).
sha256sums=('SKIP')

prepare() {
  cd "$_srcdir"
  # Pin the toolchain so a user's rustup default (for example nightly) cannot
  # change the build, then download every dependency in Cargo.lock for the host
  # target only, so build() and check() run offline against exactly the
  # versions the project's own tests use.
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$_srcdir"
  export RUSTUP_TOOLCHAIN=stable
  # A user-wide CARGO_TARGET_DIR would put the binary where package() does not
  # look. No --all-features: the crate's only feature, `testing`, compiles test
  # fixtures into the library and is never meant for a release build.
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

check() {
  cd "$_srcdir"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  # Every test suite is headless (R6.2), so this needs no display. Tests run in
  # the default debug profile, as the Arch Rust guidelines advise and as the
  # project's CI does: a release build would disable overflow checks and
  # debug_assert!, which the tests are meant to exercise.
  cargo test --frozen
}

package() {
  cd "$_srcdir"
  install -Dm755 target/release/settings4000 -t "$pkgdir/usr/bin/"
  # Installed verbatim: its `Exec=settings4000` resolves through PATH to
  # /usr/bin, so the rewrite install.sh performs for ~/.local/bin is not needed.
  install -Dm644 "data/$_app_id.desktop" -t "$pkgdir/usr/share/applications/"
  install -Dm644 "data/$_app_id.svg" \
    -t "$pkgdir/usr/share/icons/hicolor/scalable/apps/"
  # MIT is not one of the common licenses Arch ships in the `licenses`
  # package, so the text must be installed with the package.
  install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname/"
}
